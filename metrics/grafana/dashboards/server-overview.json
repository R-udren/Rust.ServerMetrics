{
  "id": null,
  "uid": "rust-local-overview",
  "title": "Rust Server Overview",
  "description": "Recent native server readings, passive player ping, network traffic, event annotations, and trends. Plugin impact has a separate focused dashboard. Client FPS reports need a separately compatible collector.",
  "tags": ["rust", "local", "overview"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": ["10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "links": [
    {
      "title": "Detailed metrics",
      "type": "link",
      "url": "/d/nvZajLJGk/rust-server-metrics",
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "Open the detailed dashboard with the same server and time range."
    },
    {
      "title": "Plugin impact & events",
      "type": "link",
      "url": "/d/rust-plugin-impact",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Logs & exceptions",
      "type": "link",
      "url": "/d/rust-server-logs",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Server events",
        "enable": true,
        "hide": false,
        "iconColor": "#FFB357",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "target": {
          "refId": "Anno",
          "rawQuery": true,
          "fromAnnotations": true,
          "query": "SELECT \"title\", \"text\", \"tags\" FROM \"server_events\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter ORDER BY time DESC LIMIT 1000",
          "titleColumn": "title",
          "textColumn": "text",
          "tagsColumn": "tags"
        }
      },
      {
        "name": "Errors & exceptions",
        "enable": true,
        "hide": false,
        "iconColor": "#FF637D",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "target": {
          "refId": "LogAnno",
          "rawQuery": true,
          "fromAnnotations": true,
          "query": "SELECT \"title\", \"text\", \"severity\" FROM \"server_logs\" WHERE (\"server\" =~ /^${server:regex}$/) AND \"severity\" =~ /^(error|exception|assert)$/ AND $timeFilter ORDER BY time DESC LIMIT 300",
          "titleColumn": "title",
          "textColumn": "text",
          "tagsColumn": "severity"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false,
        "current": {
          "text": "Rust Local Metrics",
          "value": "rust-local-influxdb",
          "selected": true
        },
        "options": []
      },
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "query": "SHOW TAG VALUES FROM \"framerate\" WITH KEY = \"server\"",
        "definition": "SHOW TAG VALUES FROM \"framerate\" WITH KEY = \"server\"",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "skipUrlSync": false,
        "current": {
          "text": "local-dev",
          "value": "local-dev",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "FPS · now",
      "description": "Latest reported server FPS within the past minute. No data means there is no recent report. This card always shows the recent state, independently of the selected chart time range.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT LAST(\"instant\") AS \"FPS\" FROM \"framerate\" WHERE (\"server\" =~ /^${server:regex}$/) AND time >= now() - 1m AND time <= now()",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "FPS",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
