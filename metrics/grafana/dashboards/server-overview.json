    {
      "id": 4,
      "type": "stat",
      "title": "Frame time · p95",
      "description": "95th percentile of recorded frame-time samples over the selected time range. These are periodic telemetry samples, not a percentile of every game frame. Lower values mean shorter frame times.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT PERCENTILE(\"instant\", 95) AS \"Recorded p95\" FROM \"frametime\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "No data",
          "mappings": [],
