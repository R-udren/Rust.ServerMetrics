    {
      "id": 13,
      "type": "timeseries",
      "title": "GC collections per minute",
      "description": "Garbage-collection rate derived from the cumulative collection counter. Negative changes at counter resets are excluded. This counts collections per minute; it does not measure CPU pressure or allocated bytes. Gaps indicate missing reports.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
