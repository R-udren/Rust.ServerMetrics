    {
      "id": 10,
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Mean incoming and outgoing traffic in bytes per second. Each telemetry report contains the bytes received or sent during the preceding second.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT MEAN(\"bytes_received\") AS \"Received\", MEAN(\"bytes_sent\") AS \"Sent\" FROM \"network\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
