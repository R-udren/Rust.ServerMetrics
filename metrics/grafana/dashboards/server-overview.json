          "query": "SELECT LAST(\"count\") AS \"Players\" FROM \"players\" WHERE (\"server\" =~ /^${server:regex}$/) AND time >= now() - 1m AND time <= now()",
          "resultFormat": "time_series",
          "alias": "$col"
        }
