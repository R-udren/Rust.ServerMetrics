        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT NON_NEGATIVE_DERIVATIVE(LAST(\"collections\"), 1m) AS \"GC collections/min\" FROM \"memory\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "$col"
        }
