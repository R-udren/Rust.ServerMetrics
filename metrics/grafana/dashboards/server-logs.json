{
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": ["10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false,
        "current": {
          "text": "Rust Local Metrics",
          "value": "rust-local-influxdb",
          "selected": true
        },
        "options": []
      },
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "query": "SHOW TAG VALUES FROM \"framerate\" WITH KEY = \"server\"",
        "definition": "SHOW TAG VALUES FROM \"framerate\" WITH KEY = \"server\"",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "skipUrlSync": false,
        "current": {
          "text": "local-dev",
          "value": "local-dev",
          "selected": true
        },
        "options": []
      },
      {
        "name": "other_logs",
        "label": "Show other logs",
        "type": "custom",
        "query": "Off : warning|error|exception|assert,On : .*",
        "current": {
          "text": "Off",
          "value": "warning|error|exception|assert"
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "query": "warning,error,exception,assert,info",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "log_search",
        "label": "Contains text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "id": null,
  "uid": "rust-server-logs",
  "title": "Rust Logs & Exceptions",
  "version": 1,
  "editable": true,
  "description": "Live Unity/framework logs and optional server log files with matching server performance. Routine logs are hidden by default.",
  "tags": ["rust", "logs", "exceptions"],
  "annotations": {
    "list": [
      {
        "name": "Server events",
        "enable": true,
        "hide": false,
        "iconColor": "#FFB357",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "target": {
          "refId": "Anno",
          "rawQuery": true,
          "fromAnnotations": true,
          "query": "SELECT \"title\", \"text\", \"tags\" FROM \"server_events\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter ORDER BY time DESC LIMIT 1000",
          "titleColumn": "title",
          "textColumn": "text",
          "tagsColumn": "tags"
        }
      },
      {
        "name": "Warnings & errors",
        "enable": true,
        "hide": false,
        "iconColor": "#FF637D",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "target": {
          "refId": "LogAnno",
          "rawQuery": true,
          "fromAnnotations": true,
          "query": "SELECT \"title\", \"text\", \"severity\" FROM \"server_logs\" WHERE (\"server\" =~ /^${server:regex}$/) AND \"severity\" =~ /^(warning|error|exception|assert)$/ AND $timeFilter ORDER BY time DESC LIMIT 300",
          "titleColumn": "title",
          "textColumn": "text",
          "tagsColumn": "severity"
        }
      },
      {
        "name": "Other server logs",
        "enable": false,
        "hide": false,
        "iconColor": "#73BF69",
        "datasource": {
          "type": "influxdb",
          "uid": "$datasource"
        },
        "target": {
          "refId": "OtherLogAnno",
          "rawQuery": true,
          "fromAnnotations": true,
          "query": "SELECT \"title\", \"text\", \"severity\" FROM \"server_logs\" WHERE (\"server\" =~ /^${server:regex}$/) AND \"severity\" = 'info' AND $timeFilter ORDER BY time DESC LIMIT 300",
          "titleColumn": "title",
          "textColumn": "text",
          "tagsColumn": "severity"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server FPS",
      "description": "Mean and lowest recorded FPS in each time bucket. Gaps indicate missing reports.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT MEAN(\"instant\") AS \"Mean\", MIN(\"instant\") AS \"Lowest\" FROM \"framerate\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "FPS",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recorded frame time",
      "description": "95th percentile and longest recorded frame-time sample in each time bucket. Periodic samples do not represent every game frame. Lower is faster.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT PERCENTILE(\"instant\", 95) AS \"Recorded p95\", MAX(\"instant\") AS \"Recorded maximum\" FROM \"frametime\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        }
      }
    },
    {
      "id": 4,
      "title": "Server logs · newest 300 matching entries",
      "type": "table",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "rawQuery": true,
          "query": "SELECT \"severity\", \"message\" AS \"Message\", \"origin\" AS \"Log stream\", \"source\" AS \"Source\", \"details_json\" AS \"Details\" FROM \"server_logs\" WHERE (\"server\" =~ /^${server:regex}$/) AND (\"severity\" =~ /^${other_logs:raw}$/) AND \"severity\" =~ /^${severity:regex}$/ AND \"message\" =~ /(?i)${log_search:regex}/ AND $timeFilter ORDER BY time DESC LIMIT 300",
          "resultFormat": "table",
          "alias": "$tag_plugin · $tag_framework"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "—",
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Details"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "json-view"
                }
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Warnings/errors by default; Show other logs includes captured routine output. Enable collection separately with metricsadapter.logs all on. Hover Details for cleaned frames. File entries use collection time and may have no severity metadata. Startup history is skipped; only configured files are tailed."
    },
    {
      "id": 5,
      "title": "Captured messages by severity · per minute",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "rawQuery": true,
          "query": "SELECT COUNT(\"message\") FROM \"server_logs\" WHERE (\"server\" =~ /^${server:regex}$/) AND (\"severity\" =~ /^${other_logs:raw}$/) AND $timeFilter GROUP BY time(1m), \"severity\" fill(null)",
          "resultFormat": "time_series",
          "alias": "$tag_severity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Log capture drops · cumulative this adapter instance",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "rawQuery": true,
          "query": "SELECT LAST(\"logs_dropped\") FROM \"adapter_health\" WHERE (\"server\" =~ /^${server:regex}$/) AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "$tag_plugin · $tag_framework"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Last adapter sample",
      "description": "Timestamp of the most recent adapter health sample. An old timestamp means this dashboard is not receiving current telemetry.",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "rawQuery": true,
          "query": "SELECT \"queued\" FROM \"adapter_health\" WHERE (\"server\" =~ /^${server:regex}$/) AND time <= now() ORDER BY time DESC LIMIT 1",
          "resultFormat": "table",
          "alias": "$tag_plugin · $tag_framework"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/.*/"
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["Time"]
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Recent capture state · past minute",
      "type": "table",
      "datasource": {
        "type": "influxdb",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "$datasource"
          },
          "rawQuery": true,
          "query": "SELECT LAST(\"log_capture\") AS \"Warnings/errors\", LAST(\"all_log_capture\") AS \"Other logs\", LAST(\"logs_dropped\") AS \"Dropped warnings/errors\", LAST(\"info_logs_dropped\") AS \"Dropped other logs\", LAST(\"log_file_errors\") AS \"File read failures\" FROM \"adapter_health\" WHERE (\"server\" =~ /^${server:regex}$/) AND time > now()-1m AND time <= now()",
          "resultFormat": "table",
          "alias": "$tag_plugin · $tag_framework"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "Unavailable",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Server overview",
      "type": "link",
      "url": "/d/rust-local-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Plugin impact & events",
      "type": "link",
      "url": "/d/rust-plugin-impact",
      "includeVars": true,
      "keepTime": true
    }
  ]
}
