<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../src/RustServerMetrics/Config/*.cs" Link="Config/%(Filename)%(Extension)" />
    <Compile Include="../../src/RustServerMetrics/MetricValues.cs" Link="MetricValues.cs" />
    <Compile Include="../../src/RustServerMetrics/UploadPolicy.cs" Link="UploadPolicy.cs" />
    <Compile Include="../../src/RustServerMetrics/ReportUploader.cs" Link="ReportUploader.cs" />
  </ItemGroup>
</Project>
